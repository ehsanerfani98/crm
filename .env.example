# =====================================================
#  CRM Clinic - Environment Variables Example
# =====================================================
# Copy this file to `.env` and adjust values for your setup:
#   cp .env.example .env
# =====================================================

# Database
# SQLite path — relative to project root. The db/ folder is gitignored.
# For MySQL/PostgreSQL, replace with the appropriate connection string:
#   MySQL:      mysql://user:password@localhost:3306/crm_clinic
#   PostgreSQL: postgresql://user:password@localhost:5432/crm_clinic
DATABASE_URL="file:./db/custom.db"

# Auth secret for signing session cookies
# Generate a long random string (e.g. run: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-secret"

# App environment
NODE_ENV="development"
